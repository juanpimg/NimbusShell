#!/bin/bash
# nimbus-bar-start — arranca nimbus-bar exactamente una vez (F3-T03).
# Sin root, HOME temporal, idempotente. Log: ~/.local/state/nimbus/bar.log.
# Invocado por nimbus-bar.service (systemd: exec en primer plano, Type=simple),
# y como fallback por el script de entorno de Plasma y el autostart .desktop.
# La instancia única real la garantiza org.nimbus.Bar en nimbus-bar (DBus);
# el pgrep de aquí solo evita un segundo lanzamiento obvio.
set -u

BIN="${NIMBUS_BAR_BIN:-/usr/local/bin/nimbus-bar}"
STATE="${XDG_STATE_HOME:-${HOME:-/tmp}/.local/state}/nimbus"
LOG="$STATE/bar.log"

mkdir -p "$STATE" 2>/dev/null || true
log() { printf '%s nimbus-bar-start: %s\n' "$(date -Is)" "$*" >>"$LOG" 2>/dev/null || true; }

if [ ! -x "$BIN" ]; then
    log "ERROR: binario no ejecutable: $BIN (instala nimbus-bar o ajusta NIMBUS_BAR_BIN)"
    exit 1
fi

# Coincidencia exacta del ejecutable (evita casar con nimbus-bar-start).
if pgrep -f -- "^${BIN}([[:space:]]|$)" >/dev/null 2>&1; then
    log "ya hay una instancia de $BIN; nada que hacer"
    exit 0
fi

# Bajo systemd (INVOCATION_ID lo pone el gestor) la unidad es Type=simple:
# exec en primer plano y systemd sigue el ciclo de vida del binario.
# Si aún no hay WAYLAND_DISPLAY (arranque temprano de default.target),
# espera hasta 30 s antes de intentarlo; Type=simple ya está "started",
# así que esto no bloquea a plasma-plasmashell.
if [ -n "${INVOCATION_ID:-}" ]; then
    tries="${NIMBUS_BAR_WAYLAND_TRIES:-60}"
    while [ -z "${WAYLAND_DISPLAY:-}" ] && [ "$tries" -gt 0 ]; do
        sleep 0.5
        tries=$((tries - 1))
    done
    if [ -z "${WAYLAND_DISPLAY:-}" ]; then
        log "AVISO: sin WAYLAND_DISPLAY tras la espera; intento el arranque igualmente"
    fi
    log "systemd (INVOCATION_ID=$INVOCATION_ID): exec en primer plano $BIN $*"
    exec "$BIN" "$@"
fi

# Fallback (env script / autostart / manual): segundo plano, sin bloquear.
log "lanzando $BIN $* en segundo plano"
nohup "$BIN" "$@" >>"$LOG" 2>&1 &
log "pid $!"
exit 0

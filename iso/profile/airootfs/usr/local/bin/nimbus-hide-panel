#!/bin/bash
# nimbus-hide-panel — oculta/auto-oculta el panel stock de Plasma cuando la
# barra Nimbus ya está viva. Idempotente y re-ejecutable (autostart + manual).
#
# Por qué así:
#  - KWin/Plasma 6.8 NO leen ~/.config/plasma/kwinrc; el panel vive en
#    plasma-org.kde.plasma.desktop-appletsrc y se controla por scripting.
#  - `evaluateScript` devuelve el valor de su última expresión. El script
#    anterior terminaba en `forEach(...)` (undefined) y qdbus imprimía vacío
#    con exit 0: parecía éxito aunque `panels()` aún no existiera. Aquí se
#    consulta `panels().length` primero y se devuelve el número de paneles
#    tocados; solo entonces se considera éxito.
#  - Si el shell aún no está listo (login lento, plasmashell reiniciándose),
#    se reintenta hasta 30 s (NIMBUS_HIDE_PANEL_TIMEOUT) y se deja rastro en
#    el log. El autostart es la red de seguridad: un fallo no aborta la sesión.
#
# PENDIENTE 6.8: eliminar el panel de forma permanente (`panel.remove()`) si
# la API de scripting lo expone; hoy no se usa porque en Plasma 6.8 no está
# garantizado y borraría configuración del usuario. Criterio de aceptación:
# el panel queda no visible/auto-hide tras login.
set -u

LOG_DIR="${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/nimbus"
LOG="$LOG_DIR/hide-panel.log"
if ! mkdir -p "$LOG_DIR" 2>/dev/null; then
    LOG="/dev/null"
fi

log() { printf '%s nimbus-hide-panel: %s\n' "$(date -Is)" "$*" >>"$LOG" 2>/dev/null || true; }

TIMEOUT="${NIMBUS_HIDE_PANEL_TIMEOUT:-30}"
case "$TIMEOUT" in
    ''|*[!0-9]*) TIMEOUT=30 ;;
esac
ATTEMPTS=$((TIMEOUT * 2))
[ "$ATTEMPTS" -ge 1 ] || ATTEMPTS=1

QDBUS=(qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript)

# Devuelve un entero no negativo o vacío (qdbus ausente, error o basura).
eval_count() {
    local out=""
    out="$(timeout 5 "${QDBUS[@]}" 'panels().length' 2>/dev/null || true)"
    case "$out" in
        ''|*[!0-9]*) printf '' ;;
        *) printf '%s' "$out" ;;
    esac
}

i=0
last=""
while [ "$i" -lt "$ATTEMPTS" ]; do
    i=$((i + 1))
    count="$(eval_count)"
    if [ -z "$count" ]; then
        last="sin respuesta de plasmashell (qdbus/evaluateScript)"
    elif [ "$count" -eq 0 ]; then
        last="panels() vacío (plasmashell aún sin paneles)"
    else
        # Se devuelve el número de paneles tocados: así qdbus no imprime vacío
        # y un fallo de la API se detecta como exit != 0 o salida no numérica.
        if out="$(timeout 5 "${QDBUS[@]}" \
            'var n = 0; panels().forEach(function(p){ p.visibilityMode = 1; p.visible = false; n++; }); n;' \
            2>&1)"; then
            case "$out" in
                ''|*[!0-9]*) last="evaluateScript devolvió «$out» (se esperaba número)" ;;
                *)
                    if [ "$out" -gt 0 ]; then
                        log "OK: $out panel(es) -> visibilityMode=1, visible=false (intento $i/$ATTEMPTS)"
                        exit 0
                    fi
                    last="paneles detectados pero 0 modificados"
                    ;;
            esac
        else
            last="evaluateScript falló: $out"
        fi
    fi
    # No inundar el log: primer intento y luego cada 10 (≈5 s).
    if [ "$i" -eq 1 ] || [ $((i % 10)) -eq 0 ]; then
        log "reintento $i/$ATTEMPTS: $last"
    fi
    sleep 0.5
done

if [ -n "$last" ] && [ "${last#panels\(\) vacío}" != "$last" ]; then
    # Sin paneles no hay nada que ocultar (o el shell no los expone): no es
    # un error de la sesión, pero queda registrado para la aceptación.
    log "AVISO: sin paneles tras ${TIMEOUT}s ($last); nada que ocultar"
    exit 0
fi
log "ERROR: no se pudo ocultar el panel tras ${TIMEOUT}s ($last)"
exit 1

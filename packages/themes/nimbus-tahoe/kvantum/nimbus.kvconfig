# Nimbus Kvantum theme — derivado de WhiteSur (Kvantum, GPL-3.0).
# Atribución: https://github.com/vinceliuice/WhiteSur-kde (autor: vinceliuice).
# Cambios Nimbus: translucidez Qt activada (vidrio Tahoe, contrato §2.4),
# acento #0A84FF (dark) según tokens Nimbus. Sin activos Apple.
# Instalado por scripts/apply-theme en ~/.config/Kvantum/nimbus.conf.
[General]
author=NimbusShell (derivado de WhiteSur por vinceliuice)
comment=Nimbus Tahoe — Qt translucido, acento Nimbus
translucent_windows=true
reduce_window_opacity=0
reduce_menu_opacity=0
shadowless_popup=false
popup_blur_radius=2
menu_blur_radius=2
tooltip_blur_radius=2
respect_DE=true
x11drag=false

[Hacks]
transparent_dolphin_view=true
transparent_pcmanfm_sidepane=false
blur_translucent=true
transparent_menubar=true
style_vertical_toolbars=true
kfont_button=true

[%General]
alt_mnemonic=true
attach_active_tab=false
attach_active_window=false
blurring=true
center_tabs=false
combo_as_lineedit=true
combo_menu=false
contrast=4
dialog_button_layout=0
double_click=false
drag_from_buttons=false
fill_rubberband=false
groupbox_top_label=true
hide_adjoined_scrollbars=false
hide_focus_rect=false
inline_spin_indicators=true
joined_inactive_tabs=false
left_tabs=false
menu_shadow_depth=30
no_inactiveness=false
scroll_arrows=false
scroll_min_extent=36
scroll_width=12
slider_width=22
small_icon_size=16
spin_button_width=20
splitter_width=1
square_scrollbar=false
submenu_delay=150
submenu_overlap=-1
tabs_on_top=false
tinted_hsl=false
toolbutton_style=2
tooltip_shadow_depth=30
transient_scrollbar=false
transient_scrollbar_alpha=100
vertical_spin_indicators=false
window_drag_from_menubar=true
window_shadow_depth=50

[Layout]
bottom_tab_overlap=0
bottom_tab_width=0
button_bottom_margin=8
button_left_margin=12
button_right_margin=12
button_top_margin=8
check_left_margin=4
check_size=16
check_top_margin=4
combo_aspect=45
default_button_margin=4
default_button_width=100
default_input_margin=4
dialog_bottom_margin=9
dialog_left_margin=9
dialog_right_margin=9
dialog_top_margin=9
dock_title_margin=2
frame_spec_group=100
groupbox_bottom_margin=8
groupbox_left_margin=8
groupbox_right_margin=8
groupbox_title_height=20
groupbox_top_margin=24
indicator_margin=0
left_tab_overlap=0
left_tab_width=0
menu_bottom_margin=5
menu_left_margin=5
menu_right_margin=5
menu_top_margin=5
radio_left_margin=4
radio_size=16
radio_top_margin=4
right_tab_overlap=0
right_tab_width=0
scroll_min_extent=36
shadowless_popup_margin=2
submenu_overlap=0
submenu_xpos=0
tab_bottom_margin=0
tab_button_extra_margin=0
tab_close_button_size=16
tab_leftright_margin=10
tab_min_height=28
tab_min_width=80
tab_top_margin=0
top_tab_overlap=0
top_tab_width=0

# NimbusOS — Glass (KWin effect) pinneado (F11-T02). GPL-3.0-or-later.
# Fork de KWin blur con refracción (Snell), rim/glow y force blur.
# Se compila en la VM/ISO de Plasma 6.8.2; no se instala desde AUR.
pkgname=kwin-effects-glass
pkgver=1edd1cd
pkgrel=1
pkgdesc='KWin blur effect with liquid-glass refraction (Nimbus pin)'
arch=('x86_64')
url='https://github.com/4v3ngR/kwin-effects-glass'
license=('GPL-3.0-or-later')
depends=(
    'kwin>=6.8'
    'kdecoration>=6.0'
    'kwindowsystem>=6.0'
    'kconfig>=6.0'
    'kcoreaddons>=6.0'
    'kcmutils>=6.0'
    'kcolorscheme>=6.0'
    'kguiaddons>=6.0'
    'ki18n>=6.0'
    'qt6-base>=6.8'
    'qt6-declarative>=6.8'
)
makedepends=(
    'cmake>=3.22'
    'ninja'
    'extra-cmake-modules>=6.0'
    'gcc>=14'
    'qt6-tools'
    'vulkan-headers'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/1edd1cdb382dacf0c8b9cb4bd28011c8de95eb58.tar.gz")
sha256sums=('SKIP')

build() {
    cmake -S "$srcdir"/kwin-effects-glass-* -B build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_TESTING=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "$srcdir"/kwin-effects-glass-*/LICENSE \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

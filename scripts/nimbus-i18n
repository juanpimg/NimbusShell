    ("KcmSystem", "packages/kcm/kcm_nimbus/ui/SystemPage.qml"),
    ("KcmUpdates", "packages/kcm/kcm_nimbus/ui/UpdatesPage.qml"),
]

STR = r'"((?:[^"\\]|\\.)*)"'
PATS = [
    re.compile(r'qsTrn?\(\s*' + STR),
    re.compile(r'\bi18n\(\s*' + STR),
    re.compile(r'\broot\.t\(\s*' + STR),
    re.compile(r'\bI18n\.tr\(\s*' + STR),
    re.compile(r'(?:^|[\s:{,])(?:text|placeholderText|label|title|Accessible\.name|Accessible\.description)\s*:\s*' + STR),
]


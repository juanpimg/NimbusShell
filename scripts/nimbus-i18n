def load_shortcut_rows():
    if not SHORTCUTS_SRC.exists():
        print(f"ERROR: falta {SHORTCUTS_SRC}", file=sys.stderr)
        sys.exit(1)
    cfg = configparser.ConfigParser(strict=False)
    cfg.optionxform = str
    cfg.read(SHORTCUTS_SRC, encoding="utf-8")
    rows = []
    for section in cfg.sections():
        for name, val in cfg.items(section):
            parts = [p.strip() for p in val.split(",", 2)]
            custom = parts[1] if len(parts) > 1 else ""
            comment = parts[2] if len(parts) > 2 else ""
            rows.append((section, name, custom, comment))
    return rows


def shortcut_cells(row):
    section, name, custom, comment = row
    mac = MAC.get(name, "\u2014")
    bind = custom if custom and custom != "none" else "\u2014"
    if custom == "none":
        bind = "\u2014 (" + (comment or "reservado") + ")"
    return mac, bind, (comment or name), f"{section}/{name}"


def export_html():
    rows = load_shortcut_rows()
    GUIDE.mkdir(parents=True, exist_ok=True)
    trs = []
    for row in rows:
        mac, bind, what, src = (escape(c) for c in shortcut_cells(row))
        trs.append(f"      <tr><td>{mac}</td><td><code>{bind}</code></td>"
                   f"<td>{what} <code>{src}</code></td></tr>")
    body = "\n".join(trs)
    html = f"""<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<title>Chuleta de atajos Nimbus / Nimbus shortcut cheat sheet</title>
<style>
body {{ font-family: sans-serif; max-width: 60rem; margin: 2rem auto; padding: 0 1rem; color: #111; }}
table {{ border-collapse: collapse; width: 100%; }}
th, td {{ border: 1px solid #999; padding: 0.35rem 0.6rem; text-align: left; }}
th {{ background: #eee; }}
code {{ font-size: 0.9em; }}
p.note {{ color: #333; }}
@media print {{ body {{ margin: 0; max-width: none; }} th {{ background: #ddd; }} }}
</style>
</head>
<body>
<h1>Chuleta de atajos Nimbus</h1>
<p class="note" lang="en">Autogenerated with <code>scripts/nimbus-i18n --export html</code>
from <code>dotfiles/.config/plasma/kglobalshortcutsrc</code>. Do not edit by hand.
<code>Meta</code> is <code>Cmd</code> (\u2318). No new <code>Ctrl</code> shortcuts by
default (R-CTRL); listed <code>Meta+Ctrl</code> bindings are documented
exceptions (Spaces and lock, as on macOS).</p>
<p class="note">Autogenerado por <code>scripts/nimbus-i18n --export html</code>
desde <code>dotfiles/.config/plasma/kglobalshortcutsrc</code>. No editar a mano.
<code>Meta</code> equivale a <code>Cmd</code> (\u2318). Sin <code>Ctrl</code> nuevos
por defecto (R-CTRL); los <code>Meta+Ctrl</code> listados son excepciones
documentadas (Spaces y bloqueo, como en macOS).</p>
<table>
<thead><tr><th>macOS</th><th>Nimbus (Plasma)</th><th>Acci\u00f3n / Action</th></tr></thead>
<tbody>
{body}
</tbody>
</table>
</body>
</html>
"""
    out = GUIDE / "shortcuts.html"
    out.write_text(html, encoding="utf-8")
    return out


def export_pdf():
    out = GUIDE / "shortcuts.pdf"
    html = export_html()
    if shutil.which("weasyprint"):
        r = subprocess.run(["weasyprint", str(html), str(out)],
                           capture_output=True, text=True)
        if r.returncode == 0:
            return 0
        print(f"ERROR: weasyprint fall\u00f3: {r.stderr.strip()}", file=sys.stderr)
        return 1
    engines = ["pdflatex", "xelatex", "lualatex", "wkhtmltopdf", "weasyprint",
               "tectonic", "groff"]
    if shutil.which("pandoc") and any(shutil.which(e) for e in engines):
        r = subprocess.run(["pandoc", str(GUIDE / "shortcuts.md"), "-o", str(out)],
                           capture_output=True, text=True)
        if r.returncode == 0:
            return 0
        print(f"ERROR: pandoc fall\u00f3: {r.stderr.strip()}", file=sys.stderr)
        return 1
    print("AVISO: sin generador PDF (falta weasyprint o pandoc+motor PDF); "
          "no se genera docs/user-guide/shortcuts.pdf. "
          "Instala con: pacman -S python-weasyprint  (o pandoc + texlive). "
          "Exit 0 documentado: no falla CI.")
    return 0


def extract():
    found = {}
    for ctx, rel in SOURCES:
        p = ROOT / rel
        if not p.exists():
            print(f"ERROR: falta fuente {rel}", file=sys.stderr)
            sys.exit(1)
        lines = p.read_text(encoding="utf-8").splitlines()
        hits = {}
        for i, line in enumerate(lines, 1):
            for pat in PATS:
                for m in pat.finditer(line):
                    s = m.group(1)
                    if s == "":
                        continue
                    hits.setdefault(s, i)
            if rel.endswith("I18n.js"):
                # Claves del dict es->en ("fuente": "traducci\u00f3n",): la
                # clave es la cadena visible; el valor va tras la coma.
                for m in re.finditer(r'^\s*"' + r'((?:[^"\\]|\\.)*)"\s*:', line):
                    if m.group(1) != "en":
                        hits.setdefault(m.group(1), i)
        for s in MANUAL.get(ctx, []):
            hits.setdefault(s, 0)
        for s, ln in hits.items():
            found.setdefault(s, []).append((ctx, rel, ln))
    return found


def ts_write(lang, found):
    I18N.mkdir(exist_ok=True)
    by_ctx = {}
    for s, locs in found.items():
        for ctx, rel, ln in locs:
            by_ctx.setdefault(ctx, {}).setdefault(s, []).append((rel, ln))
    root = ET.Element("TS", version="2.1", language=lang)
    for ctx in sorted(by_ctx):
        ce = ET.SubElement(root, "context")
        ET.SubElement(ce, "name").text = ctx
        for s in sorted(by_ctx[ctx]):
            me = ET.SubElement(ce, "message")
            for rel, ln in sorted(set(by_ctx[ctx][s])):
                ET.SubElement(me, "location", filename=rel, line=str(ln))
            ET.SubElement(me, "source").text = s
            tr = s if lang == "es" else EN.get(s)
            if tr is None:
                print(f"ERROR: sin traducci\u00f3n en para {s!r} (contexto {ctx})", file=sys.stderr)
                sys.exit(1)
            ET.SubElement(me, "translation").text = tr
    tree = ET.ElementTree(root)
    ET.indent(tree, space="    ")
    out = I18N / f"nimbus_{lang}.ts"
    tree.write(out, encoding="utf-8", xml_declaration=True)
    # DOCTYPE que espera Linguist (ElementTree no lo escribe).
    txt = out.read_text(encoding="utf-8").replace(
        "<?xml version='1.0' encoding='utf-8'?>",
        "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<!DOCTYPE TS>", 1)
    out.write_text(txt + "\n", encoding="utf-8")
    return out


def ts_read(path):
    tree = ET.parse(str(path))
    srcs, unfinished = {}, 0
    for ctx in tree.getroot().iter("context"):
        name = ctx.findtext("name")
        for m in ctx.iter("message"):
            s = m.findtext("source")
            t = m.find("translation")
            if t is None or (t.text or "") == "" or t.get("type") == "unfinished":
                unfinished += 1
            srcs.setdefault(s, set()).add(name)
    return srcs, unfinished


if CMD == "--extract":
    found = extract()
    missing = [s for s in found if s not in EN]
    if missing:
        print("ERROR: sin traducci\u00f3n en para "
              + ", ".join(repr(s) for s in sorted(missing)[:10]), file=sys.stderr)
        sys.exit(1)
    es = ts_write("es", found)
    en = ts_write("en", found)
    print(f"EXTRACT_OK: {len(found)} cadenas -> {es.name}, {en.name}")

elif CMD == "--check":
    fails = 0
    for lang in ("es", "en"):
        p = I18N / f"nimbus_{lang}.ts"
        if not p.exists():
            print(f"FAIL: falta {p.relative_to(ROOT)} (ejecuta --extract)", file=sys.stderr)
            sys.exit(1)
        try:
            srcs, unfinished = ts_read(p)
        except ET.ParseError as e:
            print(f"FAIL: XML inv\u00e1lido en {p.name}: {e}", file=sys.stderr)
            sys.exit(1)
        if unfinished:
            print(f"FAIL: {p.name} tiene {unfinished} traducciones vac\u00edas/sin terminar", file=sys.stderr)
            fails += 1
    found = extract()
    for lang in ("es", "en"):
        srcs, _ = ts_read(I18N / f"nimbus_{lang}.ts")
        falta = sorted(set(found) - set(srcs))
        sobra = sorted(set(srcs) - set(found))
        if falta:
            print(f"FAIL: nimbus_{lang}.ts sin {len(falta)} cadenas (p. ej. {falta[0]!r}); ejecuta --extract", file=sys.stderr)
            fails += 1
        if sobra:
            print(f"FAIL: nimbus_{lang}.ts con {len(sobra)} cadenas obsoletas (p. ej. {sobra[0]!r}); ejecuta --extract", file=sys.stderr)
            fails += 1
    es_srcs, _ = ts_read(I18N / "nimbus_es.ts")
    en_srcs, _ = ts_read(I18N / "nimbus_en.ts")
    if set(es_srcs) != set(en_srcs):
        print("FAIL: cobertura es/en distinta", file=sys.stderr)
        fails += 1
    missing_en = [s for s in found if s not in EN]
    if missing_en:
        print("FAIL: sin traducci\u00f3n en para "
              + ", ".join(repr(s) for s in sorted(missing_en)[:10]), file=sys.stderr)
        fails += 1
    if fails:
        sys.exit(1)
    print(f"CHECK_OK: {len(found)} cadenas es/en, 0 unfinished, TS sincronizados")

elif CMD == "--stats":
    found = extract()
    by_ctx = {}
    for s, locs in found.items():
        for ctx, _, _ in locs:
            by_ctx.setdefault(ctx, set()).add(s)
    total = 0
    for ctx in sorted(by_ctx):
        n = len(by_ctx[ctx])
        total += n
        print(f"{ctx}: {n} es + {n} en")
    print(f"Total: {total} pares cadena/contexto, {len(found)} cadenas \u00fanicas")

elif CMD == "--cheatsheet":
    rows = load_shortcut_rows()
    GUIDE.mkdir(parents=True, exist_ok=True)
    out = GUIDE / "shortcuts.md"
    L = []
    L.append("# Chuleta de atajos Nimbus")
    L.append("")
    L.append("> Autogenerado por `scripts/nimbus-i18n --cheatsheet` desde")
    L.append("> `dotfiles/.config/plasma/kglobalshortcutsrc`. No editar a mano.")
    L.append(">")
    L.append("> `Meta` equivale a `Cmd` (\u2318). Por defecto no se crean")
    L.append("> atajos `Ctrl` nuevos (R-CTRL); los `Meta+Ctrl` listados son")
    L.append("> excepciones documentadas (Spaces y bloqueo, como en macOS).")
    L.append("")
    L.append("| macOS | Nimbus (Plasma) | Acci\u00f3n |")
    L.append("| --- | --- | --- |")
    for section, name, custom, comment in rows:
        mac = MAC.get(name, "\u2014")
        bind = custom if custom and custom != "none" else "\u2014"
        if custom == "none":
            bind = "\u2014 (" + (comment or "reservado") + ")"
        what = comment or name
        L.append(f"| {mac} | `{bind}` | {what} `{section}/{name}` |")
    out.write_text("\n".join(L) + "\n", encoding="utf-8")
    n = len(rows)
    print(f"CHEATSHEET_OK: {n} atajos -> docs/user-guide/shortcuts.md")

elif CMD == "--export":
    if FMT == "html":
        out = export_html()
        print(f"EXPORT_OK: html -> {out.relative_to(ROOT)}")
    elif FMT == "pdf":
        rc = export_pdf()
        sys.exit(rc)
    else:
        print(f"ERROR: formato desconocido: {FMT}", file=sys.stderr)
        sys.exit(2)

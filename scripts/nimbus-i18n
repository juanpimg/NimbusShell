SOURCES = [
    ("Welcome", "apps/nimbus-welcome/qml/Welcome.qml"),
    ("WelcomeI18n", "apps/nimbus-welcome/qml/I18n.js"),
    ("Spotlight", "apps/nimbus-spotlight/qml/Spotlight.qml"),
    ("AppsWindow", "apps/nimbus-apps/qml/AppsWindow.qml"),

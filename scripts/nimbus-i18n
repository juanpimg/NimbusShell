#!/usr/bin/env bash
# nimbus-i18n — dueño único de i18n (F11-T05): extrae, verifica y publica.
# Sin root, sin red, solo lectura salvo --extract/--cheatsheet (escriben
# i18n/*.ts y docs/user-guide/shortcuts.md dentro del repo).
# Uso: scripts/nimbus-i18n [--extract|--check|--stats|--cheatsheet|--help]
set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CMD="${1:- --help}"

case "$CMD" in
    --extract|--check|--stats|--cheatsheet) ;;
    --export)
        FMT="${2:-}"
        case "$FMT" in
            html|pdf) ;;
            *) echo "ERROR: --export necesita html|pdf (ver --help)" >&2; exit 2 ;;
        esac
        ;;
    -h|--help)
        echo "Uso: scripts/nimbus-i18n [--extract|--check|--stats|--cheatsheet|--export html|pdf]"
        echo "  --extract    regenera i18n/nimbus_es.ts y nimbus_en.ts desde QML/JS"
        echo "  --check      falla si hay TS desincronizado o cadenas sin traducir"
        echo "  --stats      cobertura es/en por contexto (solo lectura)"
        echo "  --cheatsheet regenera docs/user-guide/shortcuts.md desde kglobalshortcutsrc"
        echo "  --export html  genera docs/user-guide/shortcuts.html (autocontenido)"
        echo "  --export pdf   genera docs/user-guide/shortcuts.pdf si hay weasyprint o"
        echo "                 pandoc+motor PDF; si no, aviso accionable y exit 0 (no falla CI)"
        exit 0 ;;
    *) echo "ERROR: argumento desconocido: $CMD (ver --help)" >&2; exit 2 ;;
esac

exec python3 - "$CMD" "${FMT:-}" "$ROOT" <<'PYEOF'
import configparser
import re
import shutil
import subprocess

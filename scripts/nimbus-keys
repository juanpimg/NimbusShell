#!/usr/bin/env bash
# nimbus-keys — atajos estilo macOS (Meta = Cmd) para Plasma.
# Genera kglobalshortcutsrc con kwriteconfig6. Seguro: sin root, sin red,
# idempotente, nunca toca la sesion del host salvo --home + --reconfigure
# con NIMBUS_KEYS_ALLOW_DBUS=1 (harness anidado). Por defecto solo escribe
# el dotfile canonico del repo. set -u (sin set -e ciego): cada fallo
# explica que falto y como reintentarlo.
set -u

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CANONICAL="$REPO_ROOT/dotfiles/.config/plasma/kglobalshortcutsrc"
MODE="meta"
ACTION="check"
HOME_DIR=""
DO_RECONFIGURE=""

usage() {
  cat <<'EOF'
Uso: nimbus-keys [--check] [--apply] [--toggle-cmd meta|ctrl] [--home DIR] [--reconfigure]

  --check            regenera en XDG temporal y compara con el dotfile (solo lectura)
  --apply            escribe el dotfile canonico (o DIR/.config con --home)
  --toggle-cmd MODE  meta (defecto, Cmd=Meta, cero Ctrl nuevos) o ctrl (opt-in)
  --home DIR         destino alternativo en vez del dotfile del repo
  --reconfigure      qdbus6 reconfigure de KWin (solo con NIMBUS_KEYS_ALLOW_DBUS=1)

Todo cambio en kglobalshortcutsrc lo lee kglobalacceld al iniciar sesion:
tras --apply hace falta RELOGIN (o reiniciar kglobalacceld). Los atajos de
los scripts KWin (Nimbus Zoom/Fullscreen, F4-T03/T04) aplican sin relogin.
EOF
}

# Tabla: grupo[+]subgrupo|clave|triggers-meta|descripcion.
# triggers "none" = sin atajo (reserva/delegacion documentada).
TABLE="$(cat <<'EOF'
kwin|Window Close|Meta+Q|cerrar ventana (Cmd+Q)
kwin|Window Minimize|Meta+M\tMeta+H|minimizar/ocultar (Cmd+M/Cmd+H; KDE sin hide-app: alias a minimizar)
kwin|Overview|Meta+W|Mission Control (Vista Overview)
kwin|Expose|Meta+E|Exposé del escritorio actual
kwin|Show Desktop|Meta+D|mostrar escritorio
kwin|Walk Through Windows|Alt+Tab\tMeta+Tab|cambiar de app (Cmd+Tab; se conserva Alt+Tab como alias)
kwin|Walk Through Windows (Reverse)|Alt+Shift+Tab\tMeta+Shift+Tab|cambiar de app hacia atrás
kwin|Walk Through Windows of Current Application|Alt+`\tMeta+`|ciclo de ventanas de la app (Cmd+`)
kwin|Switch One Desktop to the Left|Meta+Ctrl+Left|Space anterior (Ctrl permitido: Spaces Ctrl+flechas)
kwin|Switch One Desktop to the Right|Meta+Ctrl+Right|Space siguiente (Ctrl permitido)
kwin|Switch One Desktop Up|Meta+Ctrl+Up|Space superior (Ctrl permitido)
kwin|Switch One Desktop Down|Meta+Ctrl+Down|Space inferior (Ctrl permitido)
kwin|Window One Desktop to the Left|Meta+Alt+Shift+Left|mover ventana al Space izquierdo
kwin|Window One Desktop to the Right|Meta+Alt+Shift+Right|mover ventana al Space derecho
kwin|Window One Desktop Up|Meta+Alt+Shift+Up|mover ventana al Space superior
kwin|Window One Desktop Down|Meta+Alt+Shift+Down|mover ventana al Space inferior
kwin|Window Quick Tile Left|Meta+Left|media ventana a la izquierda (Cmd+flecha)
kwin|Window Quick Tile Right|Meta+Right|media ventana a la derecha
kwin|Window Quick Tile Top|Meta+Up|ventana arriba (borde sup.=maximizar)
kwin|Window Quick Tile Bottom|Meta+Down|ventana abajo
kwin|Window Fullscreen|none|delegado al script Nimbus Fullscreen Meta+F (F4-T04)
kwin|Window Maximize|none|maximizar con doble-clic (kwinrc); Meta+M es minimizar
services+org.kde.krunner.desktop|_launch|Meta+Space\tSearch\tAlt+F2|Spotlight (Cmd+Espacio; se conserva Alt+F2)
services+org.kde.krunner.desktop|RunClipboard|Meta+Alt+Space|historial del portapapeles (Opt+Cmd+Espacio)
services+org.kde.spectacle.desktop|FullScreenScreenShot|Meta+Shift+3|captura de pantalla (Cmd+Shift+3)
services+org.kde.spectacle.desktop|RectangularRegionScreenShot|Meta+Shift+4|captura de región (Cmd+Shift+4)
services+org.kde.spectacle.desktop|ActiveWindowScreenShot|Meta+Shift+5|ventana activa (≈Cmd+Shift+5)
KDE Keyboard Layout Switcher|Switch to Next Keyboard Layout|none|libera Meta+Espacio para KRunner
plasmashell|activate task manager entry 1|none|reservado Apps/Spotlight F6-T04 (Cmd+1)
plasmashell|activate task manager entry 2|none|reservado Apps/Spotlight F6-T04 (Cmd+2)
plasmashell|activate task manager entry 3|none|reservado Apps/Spotlight F6-T04 (Cmd+3)
plasmashell|activate task manager entry 4|none|reservado Apps/Spotlight F6-T04 (Cmd+4)
EOF
)"

while [ $# -gt 0 ]; do
  case "$1" in
    --check) ACTION="check" ;;
    --apply) ACTION="apply" ;;
    --toggle-cmd)
      MODE="${2:-}"
      if [ -z "$MODE" ]; then echo "ERROR: --toggle-cmd necesita 'meta' o 'ctrl'." >&2; exit 1; fi
      shift
      ;;
    --home)
      HOME_DIR="${2:-}"
      if [ -z "$HOME_DIR" ]; then echo "ERROR: --home necesita un directorio." >&2; exit 1; fi
      shift
      ;;
    --reconfigure) DO_RECONFIGURE="yes" ;;
    -h|--help) usage; exit 0 ;;
    *) echo "ERROR: flag desconocido '$1'. Usa --help." >&2; exit 1 ;;
  esac
  shift
done
if [ "$MODE" != "meta" ] && [ "$MODE" != "ctrl" ]; then
  echo "ERROR: --toggle-cmd admite solo 'meta' o 'ctrl' (llego '$MODE')." >&2; exit 1
fi
if [ "$(id -u)" = "0" ]; then
  echo "ERROR: no ejecutar como root (el perfil Plasma es por usuario)." >&2; exit 1
fi
command -v kwriteconfig6 >/dev/null 2>&1 || {
  echo "ERROR: falta kwriteconfig6. Instala plasma-desktop y reintenta." >&2; exit 1
}

# Modo ctrl (opt-in): Meta+<tecla simple> pasa a Ctrl+<tecla>; flechas,
# Espacio, modificadores compuestos y Shift+digito quedan intactos.
to_triggers() {
  if [ "$MODE" = "ctrl" ]; then
    # Protege Meta+Ctrl+* (Spaces documentado: queda igual en ambos modos).
    printf '%s' "$1" | sed 's/Meta+Ctrl+/__METACTRL__/g; s/Meta+\([A-Za-z0-9`]\|Tab\)/Ctrl+\1/g; s/__METACTRL__/Meta+Ctrl+/g'
  else
    printf '%s' "$1"
  fi
}

generate_to() {
  tmp_cfg="$1"
  while IFS='|' read -r groups key trig desc; do
    [ -n "$groups" ] || continue
    trig="$(to_triggers "$trig")"
    if [ "$key" = "_launch" ]; then
      value="$trig"
    elif [ "$trig" = "none" ]; then
      value="none,none,$desc"
    else
      value="$trig,$trig,$desc"
    fi
    # La tabla escribe \t legible; kwriteconfig6 debe recibir TAB reales
    # (al guardar los escapa a \t de KConfig; con \\t el multi-disparo
    # llegaria como texto literal y kglobalaccel no lo partiria).
    value="$(printf '%b' "$value")"
    args=()
    rest="$groups"
    while [ -n "$rest" ]; do
      part="${rest%%+*}"
      args+=(--group "$part")
      if [ "$rest" = "$part" ]; then rest=""; else rest="${rest#*+}"; fi
    done
    XDG_CONFIG_HOME="$tmp_cfg" kwriteconfig6 --file kglobalshortcutsrc \
      "${args[@]}" --key "$key" "$value" || {
      echo "ERROR: kwriteconfig6 fallo en [$groups] $key. Revisa permisos de $tmp_cfg." >&2
      return 1
    }
  done <<EOF
$TABLE
EOF
}

TMP_GEN="$(mktemp -d /tmp/opencode/nimbus-keys-XXXXXX)"
trap 'rm -rf "$TMP_GEN"' EXIT
generate_to "$TMP_GEN" || exit 1

TARGET="$CANONICAL"
if [ -n "$HOME_DIR" ]; then
  mkdir -p "$HOME_DIR/.config" || { echo "ERROR: no se pudo crear $HOME_DIR/.config." >&2; exit 1; }
  TARGET="$HOME_DIR/.config/kglobalshortcutsrc"
fi

if [ "$ACTION" = "check" ]; then
  if [ ! -f "$TARGET" ]; then
    echo "CHECK: $TARGET no existe (modo $MODE). Ejecuta: scripts/nimbus-keys --apply"
    exit 1
  fi
  if diff -u "$TARGET" "$TMP_GEN/kglobalshortcutsrc" >"$TMP_GEN/diff.txt" 2>&1; then
    echo "CHECK OK: $TARGET coincide (modo $MODE, $(grep -c '' "$TARGET") lineas)."
    ctrls="$(grep -ci 'ctrl' "$TARGET" || true)"
    echo "CHECK: lineas con 'ctrl': $ctrls (solo Meta+Ctrl+flechas en modo meta)."
    exit 0
  else
    echo "CHECK: diferencias en $TARGET (modo $MODE):" >&2
    head -30 "$TMP_GEN/diff.txt" >&2
    echo "Sincroniza con: scripts/nimbus-keys --apply [--toggle-cmd $MODE]" >&2
    exit 1
  fi
fi

# --apply (idempotente: kwriteconfig6 sobrescribe las mismas claves).
mkdir -p "$(dirname "$TARGET")"
cp -f "$TMP_GEN/kglobalshortcutsrc" "$TARGET" || {
  echo "ERROR: no se pudo escribir $TARGET. Revisa permisos." >&2; exit 1
}
echo "APPLY OK: $TARGET (modo $MODE). Requiere RELOGIN (kglobalacceld lee al iniciar)."

if [ -n "$DO_RECONFIGURE" ]; then
  if [ "${NIMBUS_KEYS_ALLOW_DBUS:-}" != "1" ]; then
    echo "NOTA: --reconfigure omitido (haría qdbus en el bus del host)."
    echo "En tu sesion corre: qdbus6 org.kde.KWin /KWin reconfigure"
    echo "Y para atajos globales: relogin (o reinicia kglobalacceld)."
  elif command -v qdbus6 >/dev/null 2>&1; then
    qdbus6 org.kde.KWin /KWin reconfigure >/dev/null 2>&1 ||
      echo "AVISO: reconfigure de KWin fallo; el relogin lo aplica igual."
  fi
fi
exit 0
